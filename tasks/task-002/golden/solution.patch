+var ErrOverloaded = errors.New("queue overloaded")
+
+type Stats struct {
+	Accepted uint64
+	Rejected uint64
+	Depth    int
+}
+type Queue struct {
+	mu       sync.Mutex
+	capacity int
+	items    []string
+	accepted uint64
+	rejected uint64
+}
+
+func New(capacity int) *Queue {
+	if capacity <= 0 {
+		panic("capacity must be positive")
+	}
+	return &Queue{capacity: capacity, items: make([]string, 0, capacity)}
+}
+func (q *Queue) Enqueue(item string) error {
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	if len(q.items) == q.capacity {
+		q.rejected++
+		return ErrOverloaded
+	}
+	q.items = append(q.items, item)
+	q.accepted++
+	return nil
+}
 func (q *Queue) Dequeue() (string, bool) {
+	q.mu.Lock()
+	defer q.mu.Unlock()
 	if len(q.items) == 0 {
 		return "", false
 	}
@@ -12,3 +47,8 @@
 	q.items = q.items[1:]
