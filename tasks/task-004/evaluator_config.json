{
  "acceptance_score": 80,
  "allowed_paths": [
    "batch/**",
    "CANDIDATE_NOTES.md"
  ],
  "build_failure_class": "build_error",
  "commands": {
    "benchmark": [
      "bash",
      "scripts/run_benchmark.sh"
    ],
    "build": [
      "go",
      "test",
      "-run",
      "^$",
      "./..."
    ],
    "determinism": [
      "bash",
      "scripts/determinism.sh"
    ],
    "format": [
      "bash",
      "scripts/format_check.sh"
    ],
    "held_out_tests": [
      "go",
      "test",
      "-race",
      "-run",
      "^TestHeldOut",
      "./..."
    ],
    "lint": [
      "go",
      "vet",
      "./..."
    ],
    "public_tests": [
      "go",
      "test",
      "-race",
      "-run",
      "^TestPublic",
      "./..."
    ],
    "regression_tests": [
      "go",
      "test",
      "-race",
      "-run",
      "^TestRegression",
      "./..."
    ]
  },
  "language": "Go",
  "output_limit_bytes": 200000,
  "performance": {
    "direction": "lower",
    "metric": "lock_acquisitions",
    "path": "benchmark_result.json",
    "threshold": 1
  },
  "required_documentation": [
    "CANDIDATE_NOTES.md"
  ],
  "task_id": "task-004",
  "timeout_seconds": 90,
  "weights": {
    "benchmark": 10,
    "build": 15,
    "determinism": 5,
    "format": 5,
    "held_out_tests": 20,
    "lint": 5,
    "public_tests": 25,
    "regression_tests": 15
  }
}
